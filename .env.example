GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
STRIPE_SECRET_KEY=
VITE_API_URL=

# Admin login (required)
# Password for /admin. Set your own value — never commit the real one.
ADMIN_PASSWORD=change-me

# Random secret used to sign admin login sessions. Generate one with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me

# Supabase (required — courses/config data lives here; see supabase/migration.sql)
# Project → Settings → API
SUPABASE_URL=https://yeuvrhiplvotthvfayfk.supabase.co
# service_role key — full DB access, bypasses RLS. Server-side only, never
# expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# MailerLite (optional — when set, every popup signup is also added to this
# group so MailerLite automations can run on it). Leave blank to skip.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
